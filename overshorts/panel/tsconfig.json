{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {"remotion": ["./node_modules/remotion"], "react": ["./node_modules/@types/react"]}
  },
  "include": ["src", "../render/src/CardStory.tsx", "../render/src/spec.ts", "../render/src/fonts.ts"]
}
